{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Joshua+",
  "version": "0.5.3",
  "identifier": "app.joshuaplus.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Joshua+",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "dragDropEnabled": true,
        "backgroundColor": "#0b0d12"
      }
    ],
    "security": {
      "freezePrototype": true,
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "media-src": "'self' blob: mediastream:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "Stem separation and practice mixer for musicians",
    "longDescription": "Joshua+ separates songs into instrument stems, detects the tempo and builds a matching click track so you can practise and play along at home.",
    "copyright": "Copyright (c) 2026 Fabricio O. de Andrade. MIT License.",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libasound2"
        ]
      }
    },
    "publisher": "Fabricio O. de Andrade",
    "homepage": "https://github.com/fabandrade88/joshuaplus",
    "macOS": {
      "minimumSystemVersion": "13.4"
    }
  }
}
